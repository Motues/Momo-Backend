# Development Settings
PORT=3000                                       # server port
DATABASE_URL="file:./data/dev.db"                # database location

# 客户端 IP 识别策略（可选，通常无需在 .env 中设置）
# 推荐直接在后台上「系统设置 → 安全设置 → 客户端 IP 识别」中开关，
# 该开关会保存到数据库；仅当需要强制指定（如不可变部署）时才使用本变量，
# 一旦设置，其优先级高于页面设置。
#
# 部署在 Nginx / Cloudflare 等反向代理之后时请开启该开关（参见 README 的 Nginx 配置章节），
# 否则所有访客都会被识别为代理 IP，导致 IP 黑名单与频率限制误伤全站。
# TRUST_PROXY=true
