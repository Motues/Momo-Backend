{
  "_comment": "评论审核自动化（垃圾规则）的跨语言固定向量。Node / Go / Worker 三端读取同一份 fixture 并各自复算 evaluateSpamRules / countLinks / parseSpamKeywords / parseSpamNumber 与后台设置校验。任何一端改了链接统计口径、长度单位（码点 vs 码元 vs 字节）、阈值语义（0 = 不启用）或规则优先级，都会立刻在这里暴露。四项阈值的默认值刻意全部为 0（不启用），升级后行为与旧版本一致。规则语义见 doc/api.md。",
  "defaults": {
    "maxLinks": 0,
    "minLength": 0,
    "duplicateWindowMinutes": 0
  },
  "limits": {
    "maxKeywords": 200,
    "maxKeywordLength": 100,
    "maxLinks": 50,
    "maxMinLength": 2000,
    "maxDuplicateWindowMinutes": 10080
  },
  "parseKeywords": [
    { "name": "未配置", "raw": "", "want": [] },
    { "name": "只有空白", "raw": "   ", "want": [] },
    { "name": "空数组", "raw": "[]", "want": [] },
    { "name": "普通数组", "raw": "[\"加微信\",\"casino\"]", "want": ["加微信", "casino"] },
    { "name": "去首尾空白并转小写", "raw": "[\"  SPAM  \",\"XSS\"]", "want": ["spam", "xss"] },
    { "name": "丢弃空串与纯空白", "raw": "[\"ok\",\"\",\"   \"]", "want": ["ok"] },
    { "name": "丢弃非字符串元素", "raw": "[\"ok\",42,null,true,{\"a\":1}]", "want": ["ok"] },
    { "name": "非法 JSON 时该规则不生效", "raw": "{oops", "want": [] },
    { "name": "非数组时该规则不生效", "raw": "{\"a\":1}", "want": [] }
  ],
  "parseNumber": [
    { "name": "未配置用默认值", "raw": "", "fallback": 3, "max": 50, "want": 3 },
    { "name": "只有空白用默认值", "raw": "   ", "fallback": 3, "max": 50, "want": 3 },
    { "name": "正常数字", "raw": "10", "fallback": 3, "max": 50, "want": 10 },
    { "name": "0 表示不启用该规则", "raw": "0", "fallback": 3, "max": 50, "want": 0 },
    { "name": "超过上限按上限夹取", "raw": "999", "fallback": 3, "max": 50, "want": 50 },
    { "name": "负数用默认值", "raw": "-1", "fallback": 3, "max": 50, "want": 3 },
    { "name": "小数用默认值", "raw": "1.5", "fallback": 3, "max": 50, "want": 3 },
    { "name": "带单位用默认值", "raw": "10m", "fallback": 5, "max": 2000, "want": 5 },
    { "name": "恰好等于上限", "raw": "2000", "fallback": 5, "max": 2000, "want": 2000 },
    { "name": "时间窗恰好等于上限", "raw": "10080", "fallback": 10, "max": 10080, "want": 10080 }
  ],
  "countLinks": [
    { "name": "空文本", "text": "", "want": 0 },
    { "name": "无链接", "text": "这是一条普通评论", "want": 0 },
    { "name": "单个 http", "text": "看 http://a.com", "want": 1 },
    { "name": "单个 https", "text": "看 https://a.com", "want": 1 },
    { "name": "带路径与查询串只算一次", "text": "看 http://a.com/path?x=1#f", "want": 1 },
    { "name": "多个带协议链接", "text": "https://a.com 和 http://b.com", "want": 2 },
    { "name": "裸 www", "text": "看 www.a.com", "want": 1 },
    { "name": "多个裸 www", "text": "www.a.com 与 www.b.com", "want": 2 },
    { "name": "https://www. 只算一次", "text": "https://www.a.com", "want": 1 },
    { "name": "Markdown 链接", "text": "[点这里](https://a.com)", "want": 1 },
    { "name": "混合形式", "text": "https://a.com 与 www.b.com", "want": 2 },
    { "name": "大小写不敏感", "text": "HTTPS://A.COM 与 WWW.B.COM", "want": 2 },
    { "name": "四个链接", "text": "https://a.com https://b.com https://c.com https://d.com", "want": 4 },
    { "name": "二十个链接", "text": "https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com https://a.com", "want": 20 }
  ],
