/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "momo-backend-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-03",
	"compatibility_flags": [ "nodejs_compat" ],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public", // 指向 Vue 编译后的文件夹
		"not_found_handling": "single-page-application" // 关键：开启 SPA 路由支持
	}
	// 注意英文逗号
	//
	// 下面两个绑定默认是注释状态：全新克隆时还不存在任何 D1 / KV 资源，
	// 直接启用会因为 database_id / id 无效而让 `wrangler dev`、`wrangler deploy` 失败。
	// 部署前请先创建资源，再把输出里的 id 填进占位符并取消注释：
	//   wrangler d1 create MOMO_DB
	//   wrangler kv namespace create MOMO_AUTH_KV
	// 注意：取消注释后要给上面 `assets` 块的结尾 `}` 补一个英文逗号，否则 JSON 非法。
	// 详见 README 的部署章节。
	//
	// "d1_databases": [
	// 	{
	// 		"binding": "MOMO_DB",
	// 		"database_name": "MOMO_DB",
	// 		"database_id": "xxxxxx"
	// 	}
	// ],
	// "kv_namespaces": [
	// 	{
	// 		"binding": "MOMO_AUTH_KV",
	// 		"id": "xxxxxx"
	// 	}
	// ]
}